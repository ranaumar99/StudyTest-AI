# ==============================================================================
# StudyTest AI - Environment Configuration
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (generating tests, grading answers).
# In Google AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted.
# Used for absolute links, social share cards, and API callbacks.
APP_URL="http://localhost:3000"

# MODEL_PRIMARY: Primary Gemini model for OCR, test generation, and grading.
MODEL_PRIMARY="gemini-3.8-flash"

# MODEL_FALLBACKS: Comma-separated list of fallback models if primary is busy.
MODEL_FALLBACKS="gemini-3.1-flash-lite"

# DEMO_MODE: When set to "true", enables explicit demo samples with visible indicator.
# If "false", real upload and real generation are required (zero fake data policy).
DEMO_MODE="false"

# MAX_FILE_MB: Maximum allowable upload file size in megabytes (default 50).
MAX_FILE_MB="50"

# PORT: Server listener port (required 3000 in AI Studio environment).
PORT="3000"

# NODE_ENV: Server execution environment ('development' | 'production').
NODE_ENV="development"

# DISABLE_HMR: Disable Vite HMR websocket in cloud-hosted proxy environments
DISABLE_HMR="true"
